{
  "name": "blueprint-deck-video",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio",
    "render:promo": "remotion render Promo out/promo.mp4 --codec=h264 --crf=18",
    "render:square": "remotion render PromoSquare out/promo-square.mp4 --codec=h264 --crf=18",
    "render:gif": "bash scripts/make-gif.sh",
    "render:stills": "node scripts/stills.mjs",
    "render:all": "npm run render:promo && npm run render:square && npm run render:short && npm run render:short-wide && npm run render:gif && npm run render:poster && npm run render:stills",
    "record": "node scripts/record-real.mjs",
    "render:short": "remotion render PromoShort out/promo-short.mp4 --codec=h264 --crf=18",
    "render:short-wide": "remotion render PromoShortWide out/promo-short-wide.mp4 --codec=h264 --crf=18",
    "render:poster": "node scripts/poster.mjs",
    "render:web": "remotion render Promo out/promo-web.mp4 --codec=h264 --crf=30"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.538",
    "@remotion/google-fonts": "^4.0.538",
    "@remotion/paths": "^4.0.538",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.538"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.538",
    "@remotion/renderer": "^4.0.538",
    "@types/react": "^19.3.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
