---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found">
  <section class="mx-auto max-w-xl px-4 py-32 text-center">
    <p class="font-mono text-sm text-brand">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">This page is not on the map</h1>
    <p class="mt-3 text-muted-foreground">The link may be old. Try the docs or the examples.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn">Home</a><a href="/docs/" class="btn" data-variant="outline">Docs</a><a href="/gallery/" class="btn" data-variant="outline">Examples</a>
    </div>
  </section>
</Base>
