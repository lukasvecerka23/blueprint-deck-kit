---
import { getEntry, render } from "astro:content";
import Docs from "../../layouts/Docs.astro";

const entry = await getEntry("reference", "spec");
if (!entry) throw new Error("skill/blueprint-deck/reference/spec.md not found");
const { Content, headings } = await render(entry);
---
<Docs title="Diagram format" description="The JSON data block of a Blueprint Deck: meta, zones, nodes, edges, tabs, personas, tour, roadmap and sheets."
  headings={headings} ownTitle source="skill/blueprint-deck/reference/spec.md">
  <Content />
</Docs>
