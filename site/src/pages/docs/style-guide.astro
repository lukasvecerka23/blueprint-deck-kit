---
import { getEntry, render } from "astro:content";
import Docs from "../../layouts/Docs.astro";

const entry = await getEntry("reference", "style-guide");
if (!entry) throw new Error("plugins/blueprint-deck/skills/blueprint-deck/reference/style-guide.md not found");
const { Content, headings } = await render(entry);
---
<Docs title="Style guide" description="Content, structure, viewpoint, layout and tour rules the agent follows, distilled from real presentation rounds."
  headings={headings} ownTitle source="plugins/blueprint-deck/skills/blueprint-deck/reference/style-guide.md">
  <Content />
</Docs>
