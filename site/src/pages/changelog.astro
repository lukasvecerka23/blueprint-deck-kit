---
import { getEntry, render } from "astro:content";
import Docs from "../layouts/Docs.astro";

const entry = await getEntry("project", "changelog");
if (!entry) throw new Error("CHANGELOG.md not found");
const { Content, headings } = await render(entry);
---
<Docs title="Changelog" description="What changed in each version of Blueprint Deck Kit, and how to update."
  headings={headings} ownTitle source="CHANGELOG.md">
  <Content />
</Docs>
