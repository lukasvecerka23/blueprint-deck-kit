---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import InstallTabs from "../components/InstallTabs.astro";
import FaqList from "../components/FaqList.astro";
import ExamplePreview from "../components/ExamplePreview.astro";
import { EXAMPLES, exampleExists, exampleHref } from "../data/examples";
import { FAQ } from "../data/faq";
import { INSTALL, SITE } from "../data/site";

const steps = [
  {
    title: "Install the skill",
    text: "From inside your agent: a plugin in Claude Code, Codex or GitHub Copilot, Gemini CLI's installer, or upload it to the Claude, ChatGPT or Gemini app. Nothing else to install.",
    code: INSTALL.claudeCli,
  },
  {
    title: "Describe your diagram",
    text: "Pick the audience, viewpoint, map detail, personas, tabs and tour story in the configurator, then copy the prompt. It carries the whole config.",
    link: { href: "/configurator/", label: "Open the configurator" },
  },
  {
    title: "Paste it into your agent",
    text: "In your project folder, or in a chat with your docs attached (Claude, ChatGPT, Gemini). The agent reads them, proposes the structure, and writes the deck plus an extraction report.",
    code: "/blueprint-deck diagrams/diagram.config.yaml",
  },
  {
    title: "Present, edit, share",
    text: "Open the file and present it. Press E to fix things, ask the agent for bigger changes, then send the file, a read-only copy, or a link: host it, or publish it as an artifact in Claude.",
    keys: ["←", "→", "E", "P"],
  },
];

const features = [
  { icon: "presentation", title: "A guided tour", text: "Present it like slides with ← →. Each step zooms to the part of the map it talks about; roadmaps and option sheets fit right in." },
  { icon: "users", title: "Tabs and persona paths", text: "Each tab highlights one question, like the request path or governance. Personas can stand on the map next to the apps they use; click one to see its numbered path." },
  { icon: "pencil", title: "Edit it, send it read-only", text: "Press E to change texts, colours, boxes, tabs and the tour, with no agent and no rebuild. Send a read-only copy when people shouldn't change it." },
  { icon: "file-check", title: "One file, opens anywhere", text: "A single offline HTML file: email it, host it, open it on a phone. It makes no network requests, so it's safe to open. Several diagrams in one file, and P for a PDF deck." },
  { icon: "palette", title: "Your brand, your audience", text: "Light and dark themes, your colours and logo. A product view for executives or a technical view for engineers." },
  { icon: "file-search", title: "From docs or code, by any agent", text: "Works with Claude Code, Codex, GitHub Copilot, Cursor, Grok Build and other agents. It reads your docs or your codebase; every box links to its source, and a report lists conflicts and gaps." },
];

const kinds = ["Architecture blueprints", "Product blueprints", "Service maps", "Data flows", "Processes", "Customer journeys", "Ecosystems", "Org maps"];
const homeFaq = FAQ.filter(f => f.home);
const FEATURED = "blueprint-deck"; // the live deck in the Examples section; the cards show the others
---
<Base>
  <!-- ============================================================ hero -->
  <section class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"><span></span><span></span></div>
    <div class="relative mx-auto max-w-7xl px-4 pt-16 pb-12 sm:px-6 sm:pt-24">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <div class="mb-6 flex flex-wrap items-center justify-center gap-2">
          <a href="/changelog/" class="badge badge-gloss gap-1.5 rounded-full px-3 py-1 text-xs" data-variant="outline" title="Still in beta: new features every week. 1.0 will be the first stable release.">
            <Icon name="flask-conical" class="size-3.5 text-brand" /> Beta · 0.x
          </a>
          <a href="#install" class="badge badge-gloss gap-1.5 rounded-full px-3 py-1 text-xs" data-variant="outline">
            <Icon name="sparkles" class="size-3.5 text-brand" /> An agent skill for Claude Code, Codex, Copilot and more
          </a>
        </div>
        <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
          Turn your docs into a <span class="text-gradient">deck people will love</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-pretty text-muted-foreground">
          Your coding agent reads your docs or code and writes one interactive HTML file: a map with a guided tour, tabs and
          personas. Present it, edit it, send it to anyone.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="#install" class="btn" data-size="lg"><Icon name="terminal" /> Install the skill</a>
          <a href="#how" class="btn" data-size="lg" data-variant="outline">How it works <Icon name="arrow-down" /></a>
        </div>
        <p class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-1 text-sm text-muted-foreground">
          <span class="inline-flex items-center gap-1.5"><Icon name="circle-check" class="size-4 text-warm" /> Free and open source, MIT License</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="circle-check" class="size-4 text-warm" /> No account, no tracking</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="circle-check" class="size-4 text-warm" /> Runs on your own agent subscription</span>
        </p>
      </div>

      <!-- the one-minute video -->
      <figure id="video" class="demo-stage mx-auto mt-14 max-w-6xl">
        <div class="browser-frame overflow-hidden rounded-xl border bg-card">
          <video class="block aspect-video w-full bg-[#050914]" preload="metadata" playsinline muted loop controls poster="/video/poster.jpg"
            aria-label="Blueprint Deck Kit in one minute: from docs to an interactive deck" data-video>
            <source src="/video/blueprint-deck.mp4" type="video/mp4" />
          </video>
        </div>
        <figcaption class="mt-4 text-center text-sm text-muted-foreground">The whole flow in one minute: your docs, the configurator, the agent, the deck.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============================================================ how it works -->
  <section id="how" class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20">
    <div class="max-w-2xl" data-reveal>
      <p class="text-sm font-medium text-brand">How it works</p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">From docs to deck in four steps</h2>
      <p class="mt-4 text-muted-foreground">The agent writes only the content (a JSON block). The engine is fixed, so every deck looks and behaves the same, and anyone can fix a text later without the agent.</p>
    </div>
    <ol class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <li class="card glow-card relative flex flex-col gap-4 p-6" data-reveal style={`--i:${i}`}>
          <span class="flex size-8 items-center justify-center rounded-full border bg-brand-soft font-mono text-sm font-semibold text-brand">{i + 1}</span>
          <div>
            <h3 class="font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{s.text}</p>
          </div>
          <div class="mt-auto">
            {s.code && <code class="block truncate rounded-md border bg-code px-3 py-2 font-mono text-xs" title={s.code}>{s.code}</code>}
            {s.link && <a href={s.link.href} class="btn w-full" data-variant="outline" data-size="sm">{s.link.label} <Icon name="arrow-right" class="size-3.5" /></a>}
            {s.keys && <div class="flex gap-1.5">{s.keys.map(k => <kbd class="kbd">{k}</kbd>)}</div>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============================================================ features -->
  <section id="features">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20">
      <div class="max-w-2xl" data-reveal>
        <p class="text-sm font-medium text-brand">Features</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">A presentation, a diagram and a document in one file</h2>
        <p class="mt-4 text-muted-foreground">Built from real presentation rounds: each feature exists because a presenter or a reviewer asked for it.</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {kinds.map(k => <li class="badge" data-variant="secondary">{k}</li>)}
        </ul>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f, i) => (
          <div class="card glow-card gap-0 p-6" data-reveal style={`--i:${i % 3}`}>
            <span class="flex size-9 items-center justify-center rounded-lg border bg-brand-soft text-brand"><Icon name={f.icon} class="size-[18px]" /></span>
            <h3 class="mt-4 font-semibold">{f.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================ examples -->
  <section id="examples">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div class="max-w-3xl">
          <p class="text-sm font-medium text-brand">Examples</p>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">See what an agent makes of real docs and code</h2>
        </div>
        <a href="/gallery/" class="btn" data-variant="outline">Open the gallery <Icon name="arrow-right" /></a>
      </div>
        <!-- featured: a live deck, the real file -->
        <div class="mt-10" data-reveal>
          <div class="browser-frame overflow-hidden rounded-xl border bg-card">
            <div class="flex items-center gap-3 border-b bg-muted/50 px-4 py-2.5">
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="size-3 rounded-full bg-[#ff5f57]"></span><span class="size-3 rounded-full bg-[#febc2e]"></span><span class="size-3 rounded-full bg-[#28c840]"></span>
              </div>
              <div class="mx-auto flex min-w-0 items-center gap-2 rounded-md border bg-background px-3 py-1 text-xs text-muted-foreground">
                <Icon name="file-code" class="size-3.5 shrink-0" /><span class="truncate">blueprint-deck-kit/diagrams/index.html</span>
              </div>
              <a href="/examples/blueprint-deck/index.html" class="btn shrink-0" data-variant="ghost" data-size="sm">
                <Icon name="maximize-2" class="size-3.5" /><span class="hidden sm:inline">Open full screen</span>
              </a>
            </div>
            <div class="relative aspect-[4/3] w-full bg-[#050914] sm:aspect-[16/9]">
              <iframe src="/examples/blueprint-deck/index.html" title="Live demo: the Blueprint Deck Kit's own Blueprint Deck" class="absolute inset-0 h-full w-full" loading="lazy"></iframe>
            </div>
          </div>
          <p class="mt-4 text-center text-sm text-muted-foreground">
            Live demo: the kit's own architecture, made by the skill from this repository. Click a box, try the tabs, start the tour and use{" "}
            <kbd class="kbd">←</kbd> <kbd class="kbd">→</kbd>, or press <kbd class="kbd">E</kbd> to edit.{" "}
            <a href="/examples/blueprint-deck/index.html" class="font-medium text-foreground underline underline-offset-4">Open full screen</a>
          </p>
        </div>
      <h3 class="mt-14 text-lg font-semibold" data-reveal>More examples</h3>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {EXAMPLES.filter(e => e.home !== false && e.slug !== FEATURED).map((e, i) => {
          const ready = exampleExists(e.slug);
          const Tag = ready ? "a" : "div";
          return (
          <Tag href={ready ? exampleHref(e.slug) : undefined} class:list={["group card glow-card overflow-hidden p-0 gap-0", !ready && "opacity-70"]} data-reveal style={`--i:${i}`}>
            <div class="aspect-[2/1] overflow-hidden border-b">
              <div class="h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.06]">
                <ExamplePreview accent={e.accent} accent2={e.accent2} theme={e.theme} seed={i + 1} slug={e.slug} alt={`${e.title}: overview`} />
              </div>
            </div>
            <div class="p-4">
              <h3 class="flex items-center justify-between font-semibold">{e.title}<Icon name="external-link" class="size-3.5 text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100" /></h3>
              <p class="mt-1 text-xs text-muted-foreground">{ready ? e.tags.join(" · ") : "Coming soon"}</p>
            </div>
          </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============================================================ install -->
  <section id="install" class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div data-reveal>
        <p class="text-sm font-medium text-brand">Install</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">One command, then ask your agent</h2>
        <p class="mt-4 text-muted-foreground">The skill is a folder: <code class="font-mono text-sm">SKILL.md</code>, the engine, the format reference and the style guide. Install it from inside your agent, upload it to the Claude, ChatGPT or Gemini app, or use the install script for any other agent. It only copies files.</p>
        <ul class="mt-6 space-y-2.5 text-sm">
          <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand" /> Claude Code, Codex, Gemini CLI, GitHub Copilot, Cursor, Grok Build, the Claude, ChatGPT and Gemini apps, and other Agent Skills agents</li>
          <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand" /> Your agent runs locally with your own subscription</li>
          <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand" /><span>Updates through your agent, or re-run the install script</span></li>
        </ul>
        <a href="/docs/" class="btn mt-8" data-variant="outline">Read the getting started guide <Icon name="arrow-right" /></a>
      </div>
      <div class="min-w-0" data-reveal style="--i:1">
        <div class="card glow-card p-5 sm:p-6">
          <InstallTabs />
        </div>
        <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted-foreground">
          Installed? Next, describe your diagram:
          <a href="/configurator/" class="btn" data-size="sm">Configure your deck <Icon name="arrow-right" class="size-3.5" /></a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================ faq -->
  <section id="faq" class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <div data-reveal>
      <p class="text-sm font-medium text-brand">FAQ</p>
      <h2 class="mt-2 mb-8 text-3xl font-semibold tracking-tight sm:text-4xl">Questions</h2>
      <FaqList items={homeFaq} />
    </div>
    <p class="mt-8 text-sm text-muted-foreground">More in the <a href="/docs/faq/" class="font-medium text-foreground underline underline-offset-4">docs FAQ</a>.</p>
  </section>

  <!-- ============================================================ cta -->
  <section class="px-4 pt-6 pb-20 sm:px-6 sm:pb-28">
    <div class="cta-card relative mx-auto max-w-5xl overflow-hidden rounded-2xl border bg-card px-6 py-14 text-center sm:px-12" data-reveal>
      <div class="relative">
        <h2 class="text-3xl font-semibold tracking-tight text-balance">Your first deck in a few minutes</h2>
        <p class="mx-auto mt-3 max-w-xl text-muted-foreground">Install the skill with one command, describe your diagram in the configurator, and paste the prompt into your agent. Everything runs on your computer; nothing is sent anywhere.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="#install" class="btn" data-size="lg"><Icon name="terminal" /> Install the skill</a>
          <a href="/configurator/" class="btn" data-size="lg" data-variant="outline">Configure your deck <Icon name="arrow-right" /></a>
        </div>
        <p class="mt-6 text-sm text-muted-foreground">
          Free forever. If it saves you time, <a class="font-medium text-foreground underline underline-offset-4 hover:text-brand" href={SITE.repo}>star it on GitHub</a>{" "}
          or <a class="font-medium text-foreground underline underline-offset-4 hover:text-brand" href={SITE.sponsor}>sponsor the project <span aria-hidden="true" class="text-pink-500">♥</span></a>
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  // scroll reveal (the CSS hides [data-reveal] only when html has .reveal, i.e. with JS and without reduced motion)
  const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if (document.documentElement.classList.contains("reveal") && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(entries => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
    }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
    items.forEach(el => io.observe(el));
  } else items.forEach(el => el.classList.add("in"));
  // the video loops, muted, while it's on screen (not with reduced motion); the controls pause, seek and unmute it.
  // It never starts on page load (also not when a reload restores the scroll position): only after the visitor
  // scrolls. Once the visitor pauses it, it stays paused.
  const video = document.querySelector<HTMLVideoElement>("[data-video]");
  if (video && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let ours = false, userPaused = false, inView = false, scrolled = false;
    const update = () => {
      if (inView && scrolled) { if (!userPaused && video.paused) video.play().catch(() => {}); }
      else if (!inView && !video.paused) { ours = true; video.pause(); }
    };
    video.addEventListener("pause", () => { if (!ours) userPaused = true; ours = false; });
    video.addEventListener("play", () => { userPaused = false; });
    new IntersectionObserver(([e]) => { inView = e.isIntersecting; update(); }, { threshold: 0.6 }).observe(video);
    const arm = () => { if (scrolled) return; scrolled = true; update(); };
    for (const ev of ["wheel", "touchmove"]) addEventListener(ev, arm, { passive: true, once: true });
    addEventListener("keydown", e => { if (["ArrowDown", "PageDown", " ", "End"].includes(e.key)) arm(); });
    // scrollbar drags and anchor links only fire "scroll"; the browser's own restore happens right at load
    setTimeout(() => addEventListener("scroll", arm, { passive: true, once: true }), 800);
  }
  // the cards' glow follows the pointer
  document.querySelectorAll<HTMLElement>(".glow-card").forEach(card => {
    card.addEventListener("pointermove", ev => {
      const r = card.getBoundingClientRect();
      card.style.setProperty("--mx", `${ev.clientX - r.left}px`);
      card.style.setProperty("--my", `${ev.clientY - r.top}px`);
    });
  });
</script>
