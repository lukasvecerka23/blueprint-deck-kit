---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ExamplePreview from "../components/ExamplePreview.astro";
import { EXAMPLES, exampleExists, exampleHref } from "../data/examples";
import { SITE } from "../data/site";
---
<Base title="Examples" description="Example Blueprint Decks generated by coding agents from real docs: architecture, processes, customer journeys and technical views. Each is one offline HTML file.">
  <section class="border-b">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="text-sm font-medium text-brand">Gallery</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">Examples</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted-foreground">Each one is a single HTML file an agent wrote from a repository's docs. Open one, click around, start the tour, press <kbd class="kbd">E</kbd> to see the editor or <kbd class="kbd">P</kbd> for the PDF deck.</p>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="grid gap-6 md:grid-cols-2">
      {EXAMPLES.map((e, i) => {
        const ready = exampleExists(e.slug);
        return (
          <article class="card overflow-hidden p-0 gap-0">
            <div class="relative aspect-[2/1] overflow-hidden border-b">
              <ExamplePreview accent={e.accent} accent2={e.accent2} theme={e.theme} seed={i + 1} slug={e.slug} alt={`${e.title}: overview`} />
              <span class="badge absolute top-3 right-3" data-variant="secondary">{e.theme === "light" ? "Light theme" : "Dark theme"}</span>
            </div>
            <div class="flex flex-1 flex-col gap-4 p-6">
              <div>
                <h2 class="text-lg font-semibold">{e.title}</h2>
                <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{e.description}</p>
              </div>
              <ul class="flex flex-wrap gap-1.5">{e.tags.map(t => <li class="badge" data-variant="outline">{t}</li>)}</ul>
              <div class="mt-auto flex flex-wrap gap-2 pt-2">
                {ready ? (
                  <>
                    <a href={exampleHref(e.slug)} class="btn" data-size="sm">Open the deck <Icon name="arrow-right" class="size-3.5" /></a>
                    <a href={`${exampleHref(e.slug)}#tour=1`} class="btn" data-size="sm" data-variant="outline"><Icon name="play" class="size-3.5" /> Start the tour</a>
                  </>
                ) : (
                  <span class="btn" data-size="sm" data-variant="secondary" aria-disabled="true">Coming soon</span>
                )}
                <a href={`${SITE.repo}/tree/main/examples/${e.slug}`} class="btn" data-size="sm" data-variant="ghost"><Icon name="github" class="size-3.5" /> View on GitHub</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
    <div class="mt-12 rounded-xl border border-dashed p-8 text-center">
      <h2 class="font-semibold">Made one for your project?</h2>
      <p class="mt-1 text-sm text-muted-foreground">Open a pull request that adds it to <code class="font-mono text-xs">examples/</code>, with its config and extraction report.</p>
      <div class="mt-4 flex justify-center gap-2">
        <a href="/configurator/" class="btn" data-size="sm">Configure your deck</a>
        <a href={SITE.repo} class="btn" data-size="sm" data-variant="outline"><Icon name="github" class="size-3.5" /> GitHub</a>
      </div>
    </div>
  </section>
</Base>
