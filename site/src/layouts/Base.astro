---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";
import VERSION from "../../../plugins/blueprint-deck/skills/blueprint-deck/VERSION.txt?raw";

interface Props {
  title?: string; description?: string; image?: string; wide?: boolean;
  /** extra schema.org objects for this page (FAQ, video, article …) */
  schema?: Record<string, unknown>[];
}
// a JPEG under ~300 KB: WhatsApp skips larger preview images
const { title, description = SITE.description, image = "/og.jpg", schema = [] } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:image:alt" content="Blueprint Deck Kit: turn your docs into a deck people will love" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {Astro.url.pathname === "/" && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "@id": `${SITE.url}/#software`,
        name: SITE.name,
        alternateName: "Blueprint Deck",
        description: SITE.summary,
        url: `${SITE.url}/`,
        applicationCategory: "DeveloperApplication",
        applicationSubCategory: "Agent skill",
        operatingSystem: "macOS, Linux, Windows",
        softwareVersion: VERSION.trim(),
        license: "https://opensource.org/licenses/MIT",
        isAccessibleForFree: true,
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        installUrl: `${SITE.url}/#install`,
        downloadUrl: `${SITE.repo}/releases/latest`,
        releaseNotes: `${SITE.url}/changelog/`,
        codeRepository: SITE.repo,
        sameAs: [SITE.repo],
        screenshot: `${SITE.url}/video/poster.jpg`,
        image: `${SITE.url}/og.jpg`,
        featureList: [
          "Generates interactive diagrams from your documents (Markdown, text, PDF, web pages) or your codebase",
          "Architecture diagrams, data flows, processes, customer journeys, ecosystems, org maps, study topics and free-form diagrams",
          "One self-contained, offline HTML file",
          "Pan-and-zoom map with clickable boxes, side panels and their sources",
          "Guided tour you present like slides",
          "Tabs and personas with numbered paths",
          "Built-in editor, no agent needed for small changes",
          "PDF export in colour or black and white",
          "Read-only copies to share",
          "Works with Claude Code, Codex, GitHub Copilot, Gemini CLI, Cursor, Grok Build and the Claude, ChatGPT and Gemini apps",
        ],
        author: [
          { "@type": "Person", name: SITE.author, url: SITE.authorUrl },
          { "@type": "Person", name: SITE.coAuthor, url: SITE.coAuthorUrl },
        ],
      })} />
    )}
    {schema.map(s => <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...s })} />)}
    <slot name="head" />
    <script is:inline>
      // scroll reveal on the landing page: only with JS and when the user hasn't asked for reduced motion
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("reveal");
    </script>
    <script is:inline>
      // theme before first paint: light, unless the visitor switched to dark with the toggle
      (() => {
        const saved = (() => { try { return localStorage.getItem("themeMode"); } catch { return null; } })();
        document.documentElement.classList.toggle("dark", saved === "dark");
      })();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] btn" data-variant="outline">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "basecoat-css/basecoat";
      import "basecoat-css/tabs";

      // theme toggle
      document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach(btn =>
        btn.addEventListener("click", () => {
          const dark = !document.documentElement.classList.contains("dark");
          document.documentElement.classList.toggle("dark", dark);
          try { localStorage.setItem("themeMode", dark ? "dark" : "light"); } catch {}
        }),
      );

      // copy buttons: <button data-copy="text"> or data-copy-target="#id"
      const copy = async (btn: HTMLElement, text: string) => {
        try { await navigator.clipboard.writeText(text); } catch {
          const ta = Object.assign(document.createElement("textarea"), { value: text });
          document.body.append(ta); ta.select(); document.execCommand("copy"); ta.remove();
        }
        btn.dataset.copied = "true";
        const label = btn.querySelector("[data-copy-label]");
        const old = label?.textContent;
        if (label) label.textContent = "Copied";
        setTimeout(() => { delete btn.dataset.copied; if (label && old) label.textContent = old; }, 1600);
      };
      document.addEventListener("click", e => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-copy], [data-copy-target]");
        if (!btn) return;
        const text = btn.dataset.copy ?? document.querySelector(btn.dataset.copyTarget!)?.textContent ?? "";
        copy(btn, text.trim());
      });

      // copy buttons on rendered code blocks
      document.querySelectorAll<HTMLPreElement>(".prose pre.astro-code").forEach(pre => {
        const wrap = document.createElement("div");
        wrap.className = "code-wrap";
        pre.replaceWith(wrap);
        wrap.append(pre);
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "btn copy-btn";
        btn.dataset.variant = "outline";
        btn.dataset.size = "xs";
        btn.innerHTML = '<span data-copy-label>Copy</span>';
        btn.addEventListener("click", () => copy(btn, pre.textContent ?? ""));
        wrap.append(btn);
      });
    </script>
  </body>
</html>
