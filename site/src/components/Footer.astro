---
import Logo from "./Logo.astro";
import { SITE } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="fade-rule">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div class="space-y-3">
      <a href="/" class="flex items-center gap-2.5 font-semibold"><Logo class="size-6" /> Blueprint Deck Kit</a>
      <p class="max-w-xs text-sm text-muted-foreground">Interactive presentation diagrams from your docs or code. One HTML file, works offline.</p>
    </div>
    <div>
      <h3 class="mb-3 text-sm font-medium">Product</h3>
      <ul class="space-y-2 text-sm text-muted-foreground">
        <li><a class="hover:text-foreground" href="/configurator/">Configurator</a></li>
        <li><a class="hover:text-foreground" href="/gallery/">Examples</a></li>
        <li><a class="hover:text-foreground" href="/#install">Install</a></li>
        <li><a class="hover:text-foreground" href="/engine/blueprint-deck.html">Empty engine</a></li>
      </ul>
    </div>
    <div>
      <h3 class="mb-3 text-sm font-medium">Docs</h3>
      <ul class="space-y-2 text-sm text-muted-foreground">
        <li><a class="hover:text-foreground" href="/docs/">Getting started</a></li>
        <li><a class="hover:text-foreground" href="/docs/configuring/">Configuring</a></li>
        <li><a class="hover:text-foreground" href="/docs/format/">Diagram format</a></li>
        <li><a class="hover:text-foreground" href="/docs/faq/">FAQ</a></li>
      </ul>
    </div>
    <div>
      <h3 class="mb-3 text-sm font-medium">Project</h3>
      <ul class="space-y-2 text-sm text-muted-foreground">
        <li><a class="hover:text-foreground" href={SITE.repo}>GitHub</a></li>
        <li><a class="inline-flex items-center gap-1 hover:text-foreground" href={SITE.sponsor}><span aria-hidden="true" class="text-pink-500">♥</span> Sponsor</a></li>
        <li><a class="hover:text-foreground" href={`${SITE.repo}/issues`}>Issues</a></li>
        <li><a class="hover:text-foreground" href={`${SITE.repo}/blob/main/LICENSE`}>MIT licence</a></li>
      </ul>
    </div>
  </div>
  <div class="fade-rule">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>© {year} Made by <a class="font-medium text-foreground hover:underline" href={SITE.authorUrl}>{SITE.author}</a>, with <a class="font-medium text-foreground hover:underline" href={SITE.coAuthorUrl} rel="noopener">{SITE.coAuthor}</a>. Released under the MIT licence.</p>
      <p>Open source: <a class="hover:text-foreground underline underline-offset-4" href={SITE.repo}>github.com/lukasvecerka23/blueprint-deck-kit</a></p>
    </div>
  </div>
</footer>
