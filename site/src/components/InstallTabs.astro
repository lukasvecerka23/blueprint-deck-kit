---
// Install options, one tab per place people work in. variant="hero": one command per agent and a one-line hint;
// variant="full" (the Install section): every option and its details.
import Command from "./Command.astro";
import Icon from "./Icon.astro";
import BrandIcon from "./BrandIcon.astro";
import { INSTALL, SITE } from "../data/site";

interface Props { id?: string; variant?: "hero" | "full" }
const { id = "install", variant = "full" } = Astro.props;
const hero = variant === "hero";
const zip = `${SITE.repo}/releases/latest/download/blueprint-deck-skill.zip`;
const zipGemini = `${SITE.repo}/releases/latest/download/blueprint-deck-skill-gemini.zip`;
const tabs = [
  { id: "claude", label: "Claude Code", brand: "claude" },
  { id: "codex", label: "Codex", brand: "openai" },
  { id: "gemini", label: "Gemini CLI", brand: "gemini" },
  { id: "copilot", label: "GitHub Copilot", icon: "github" },
  { id: "apps", label: "Chat apps", icon: "message-square" },
  { id: "other", label: "Install script", icon: "terminal" },
  ...(hero ? [] : [{ id: "manual", label: "Manual", icon: "download" }]),
];
const hint = "text-sm text-muted-foreground";
const code = "font-mono text-xs";
const link = "underline underline-offset-4 hover:text-foreground";
---
<div class:list={["tabs w-full", hero ? "gap-3" : "gap-4"]} id={`${id}-tabs`}>
  <nav role="tablist" aria-orientation="horizontal" class:list={["h-auto max-w-full", hero ? "mx-auto flex-wrap justify-center" : "grid w-full grid-cols-2 sm:grid-cols-4"]}>
    {tabs.map((t, i) => (
      <button type="button" role="tab" id={`${id}-tab-${t.id}`} aria-controls={`${id}-panel-${t.id}`}
        aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} class="gap-1.5">
        {t.brand ? <BrandIcon name={t.brand} class="size-3.5 shrink-0" /> : <Icon name={t.icon!} class="size-3.5 shrink-0" />}{t.label}</button>
    ))}
  </nav>

  <!-- Claude Code: the plugin -->
  <div role="tabpanel" id={`${id}-panel-claude`} aria-labelledby={`${id}-tab-claude`} tabindex="-1" class="space-y-3">
    <Command code={INSTALL.claudeCli} />
    {hero ? (
      <p class={hint}>Run it in your terminal, then type <code class={code}>/blueprint-deck</code> in Claude Code or paste the prompt from the configurator.</p>
    ) : (
      <>
        <p class={hint}>Run it in your terminal: it adds this repository as a plugin marketplace and installs the plugin. Or inside Claude Code:</p>
        <Command code={INSTALL.claudePlugin} prompt=">" />
        <p class={hint}>Needs Claude Code 2.1.275 or later (older: <code class={code}>/plugin marketplace add lukasvecerka23/blueprint-deck-kit</code>,
          then <code class={code}>/plugin install blueprint-deck@blueprint-deck-kit</code>). Then type <code class={code}>/blueprint-deck</code>{" "}
          or paste the prompt from the configurator. Updates: turn on auto-update under <code class={code}>/plugin</code> → Marketplaces, or run{" "}
          <code class={code}>claude plugin update blueprint-deck@blueprint-deck-kit</code>.</p>
      </>
    )}
  </div>

  <!-- Codex: our repository is a plugin marketplace; the plugin also appears in the ChatGPT desktop app -->
  <div role="tabpanel" id={`${id}-panel-codex`} aria-labelledby={`${id}-tab-codex`} tabindex="-1" class="space-y-3" hidden>
    <Command code={INSTALL.codexPlugin} />
    {hero ? (
      <p class={hint}>Run it in your terminal: it adds the marketplace and installs the plugin (also for the ChatGPT desktop app). Then ask Codex for a deck.</p>
    ) : (
      <>
        <p class={hint}>Run it in your terminal: it adds this repository as a plugin marketplace and installs Blueprint Deck. The plugin also appears
          in the ChatGPT desktop app. Updates: <code class={code}>codex plugin marketplace upgrade</code>. Or, inside Codex, its own skill installer
          (installs from <code class={code}>main</code>, doesn't update later):</p>
        <Command code={INSTALL.codexSkill} prompt=">" />
      </>
    )}
  </div>

  <!-- Gemini CLI -->
  <div role="tabpanel" id={`${id}-panel-gemini`} aria-labelledby={`${id}-tab-gemini`} tabindex="-1" class="space-y-3" hidden>
    <Command code={INSTALL.geminiSkill} />
    {hero ? (
      <p class={hint}>Gemini CLI's own skill installer. Then start <code class={code}>gemini</code> in your project folder and ask for a Blueprint Deck.</p>
    ) : (
      <>
        <p class={hint}>Gemini CLI's own skill installer, straight from GitHub. Check with <code class={code}>/skills list</code>. Or with the script, into{" "}
          <code class={code}>~/.gemini/skills</code>:</p>
        <Command code={INSTALL.shAgent("gemini")} />
        <Command code={INSTALL.psAgent("gemini")} prompt="PS>" />
      </>
    )}
  </div>

  <!-- GitHub Copilot: the Copilot CLI reads our marketplace; VS Code and Visual Studio read ~/.copilot/skills -->
  <div role="tabpanel" id={`${id}-panel-copilot`} aria-labelledby={`${id}-tab-copilot`} tabindex="-1" class="space-y-3" hidden>
    <Command code={INSTALL.copilotPlugin} />
    {hero ? (
      <p class={hint}>For the Copilot CLI. In VS Code or Visual Studio: <code class={code}>{INSTALL.copilotGh}</code>. Then ask Copilot (agent mode) for a deck.</p>
    ) : (
      <>
        <p class={hint}>For the Copilot CLI: it adds this repository as a plugin marketplace and installs Blueprint Deck. Updates:{" "}
          <code class={code}>copilot plugin update blueprint-deck</code>. For Copilot in VS Code or Visual Studio, install the skill into{" "}
          <code class={code}>~/.copilot/skills</code> with the GitHub CLI (2.90 or later; updates: <code class={code}>gh skill update blueprint-deck</code>):</p>
        <Command code={INSTALL.copilotGh} />
        <p class={hint}>Or with the script (<code class={code}>--project</code> puts it into the repository's <code class={code}>.github/skills</code>, which the Copilot cloud agent reads too):</p>
        <Command code={INSTALL.shAgent("copilot")} />
        <Command code={INSTALL.psAgent("copilot")} prompt="PS>" />
      </>
    )}
  </div>

  <!-- the chat apps: Claude and ChatGPT (web) take the zip, Gemini a zip without tools/, the ChatGPT desktop app the Codex plugin -->
  <div role="tabpanel" id={`${id}-panel-apps`} aria-labelledby={`${id}-tab-apps`} tabindex="-1" class="space-y-3" hidden>
    <div class:list={["flex flex-wrap items-center gap-3", hero && "justify-center"]}>
      <a href={zip} class="btn" data-variant="outline"><Icon name="download" class="size-4" /> Download the skill (.zip)</a>
      <a href={zipGemini} class="btn" data-variant="ghost"><BrandIcon name="gemini" class="size-3.5" /> For Gemini (.zip)</a>
      {!hero && <a class={`${hint} ${link}`} href={`${SITE.repo}/releases`}>all versions</a>}
    </div>
    {hero ? (
      <p class={hint}>Upload it unchanged: <span class="font-medium text-foreground">Claude</span> under Customize → Skills, <span class="font-medium text-foreground">ChatGPT</span> on the web
        under Plugins → Skills, <span class="font-medium text-foreground">Gemini</span> (its own zip) under Customize → Skills. The ChatGPT desktop app takes the plugin from the Codex tab.</p>
    ) : (
      <ul class={`${hint} list-disc space-y-1.5 pl-5`}>
        <li><span class="font-medium text-foreground">Claude</span> (web and desktop app, paid plans): Customize → Skills → upload the zip, turn it on. Code execution must be on.</li>
        <li><span class="font-medium text-foreground">ChatGPT on the web</span> (paid plans): Plugins → Skills → Create → Upload the zip.</li>
        <li><span class="font-medium text-foreground">ChatGPT desktop app</span>: no upload; it takes plugins. Install the Codex plugin (Codex tab), or in the app:
          Plugins → add the marketplace <code class={code}>lukasvecerka23/blueprint-deck-kit</code>, then install Blueprint Deck.</li>
        <li><span class="font-medium text-foreground">Gemini</span> (web and desktop app): Customize → Skills → upload the Gemini zip (the same skill without the optional
          Node tools, which the Gemini app doesn't accept).</li>
        <li>Then attach your docs to a chat and ask for a Blueprint Deck. In a chat the skill only sees the files you attach, and you get the HTML file to download.{" "}
          <a class={link} href="/docs/agents/#chat-apps-claude-chatgpt-gemini">Details</a>.</li>
      </ul>
    )}
  </div>

  <!-- the install script: any agent, several at once, Windows, specific versions -->
  <div role="tabpanel" id={`${id}-panel-other`} aria-labelledby={`${id}-tab-other`} tabindex="-1" class="space-y-3" hidden>
    <Command code={INSTALL.sh} />
    <Command code={INSTALL.ps} prompt="PS>" />
    {hero ? (
      <p class={hint}>The install script (macOS/Linux, then Windows): installs for Claude Code, Codex, Gemini CLI, GitHub Copilot and other Agent Skills agents it finds, and asks which.{" "}
        <a class={link} href="#install">All options</a>.</p>
    ) : (
      <p class={hint}>The install script, for macOS/Linux and for Windows PowerShell. It installs the latest release for the agents it finds
        (<code class={code}>~/.claude/skills</code>, <code class={code}>~/.codex/skills</code>, <code class={code}>~/.gemini/skills</code>, <code class={code}>~/.copilot/skills</code>, <code class={code}>~/.agents/skills</code>) and asks which when there are several.
        Options: <code class={code}>--agent claude|codex|gemini|copilot|agents|all</code>, <code class={code}>--dir &lt;skills folder&gt;</code> for any other agent,{" "}
        <code class={code}>--project</code> (into the current project), <code class={code}>--version 0.5.1</code>, <code class={code}>--yes</code>, <code class={code}>--uninstall</code>;
        pass them with <code class={code}>sh -s --</code> (PowerShell: <code class={code}>-Agent</code>, <code class={code}>-Version</code> …). Run it again to update.
        It only copies files. Read the <a class={link} href="/install.sh">shell</a> or <a class={link} href="/install.ps1">PowerShell</a> script.
        Agents without skill support can follow <code class={code}>blueprint-deck/SKILL.md</code> as instructions: tell them to read it first.</p>
    )}
  </div>

  {!hero && (
    <div role="tabpanel" id={`${id}-panel-manual`} aria-labelledby={`${id}-tab-manual`} tabindex="-1" class="space-y-3" hidden>
      <div class="flex flex-wrap items-center gap-3">
        <a href={zip} class="btn" data-variant="outline"><Icon name="download" class="size-4" /> Download the skill (.zip)</a>
        <span class={hint}>the latest release, one folder <code class={code}>blueprint-deck/</code> ·
          <a class={link} href={`${SITE.repo}/releases`}>all versions</a></span>
      </div>
      <Command code="unzip blueprint-deck-skill.zip -d ~/.claude/skills" />
      <p class={hint}>Unzip into your agent's skills folder, e.g. <code class={code}>~/.claude/skills/</code>, <code class={code}>~/.codex/skills/</code>,{" "}
        <code class={code}>~/.agents/skills/</code>, or <code class={code}>.claude/skills/</code> inside a repository. The result is <code class={code}>…/skills/blueprint-deck/SKILL.md</code>.</p>
    </div>
  )}
</div>
