---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { SITE } from "../data/site";

const path = Astro.url.pathname;
const links = [
  { href: "/docs/", label: "Docs", active: path.startsWith("/docs") },
  { href: "/gallery/", label: "Examples", active: path.startsWith("/gallery") },
  { href: "/configurator/", label: "Configurator", active: false },
];
---
<header id="site-header" class="sticky top-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled]:border-border bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/65">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight" aria-label={`${SITE.name} home`}>
      <Logo class="size-7" />
      <span>Blueprint Deck</span>{" "}
      <span class="badge hidden sm:inline-flex" data-variant="outline">Kit</span>
    </a>
    <nav class="ml-4 hidden items-center gap-1 text-sm md:flex" aria-label="Main">
      {links.map(l => (
        <a href={l.href} class:list={["rounded-md px-3 py-1.5 transition-colors hover:text-foreground", l.active ? "text-foreground font-medium" : "text-foreground/70"]}
          aria-current={l.active ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <a href={SITE.repo} class="btn gap-1.5 px-2.5" data-variant="ghost" aria-label="GitHub repository" title="Star on GitHub">
        <Icon name="github" class="size-[18px]" /><span class="font-mono text-xs" data-stars hidden></span>
      </a>
      <button type="button" class="btn" data-variant="ghost" data-size="icon" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode">
        <Icon name="sun" class="size-[18px] hidden dark:block" />
        <Icon name="moon" class="size-[18px] block dark:hidden" />
      </button>
      <a href="/#install" class="btn ml-1 hidden sm:inline-flex" data-size="sm"><Icon name="terminal" /> Install</a>
      <details class="relative md:hidden">
        <summary class="btn list-none [&::-webkit-details-marker]:hidden" data-variant="ghost" data-size="icon" aria-label="Menu">
          <Icon name="menu" class="size-[18px]" />
        </summary>
        <div class="absolute right-0 mt-2 w-52 rounded-lg border bg-popover p-1.5 shadow-lg">
          {links.map(l => <a href={l.href} class="block rounded-md px-3 py-2 text-sm hover:bg-accent">{l.label}</a>)}
          <a href={SITE.repo} class="block rounded-md px-3 py-2 text-sm hover:bg-accent">GitHub</a>
        </div>
      </details>
    </div>
  </div>
</header>
<script>
  const header = document.getElementById("site-header");
  const onScroll = () => header?.toggleAttribute("data-scrolled", scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true }); onScroll();
  // the star count comes from our own /api/stars (a Cloudflare Pages Function that caches GitHub's answer), so
  // visitors' browsers never call GitHub; shown from 25 stars up
  // (not on localhost: the function only runs on Cloudflare, and the failed request would show as a console error)
  const starCount = document.querySelector<HTMLElement>("[data-stars]");
  if (starCount && !/^(localhost|127\.0\.0\.1)$/.test(location.hostname)) fetch("/api/stars").then(r => (r.ok ? r.json() : null)).then(d => {
    if (d && typeof d.stars === "number" && d.stars >= 25) { starCount.textContent = `★ ${d.stars}`; starCount.hidden = false; }
  }).catch(() => {});
</script>
